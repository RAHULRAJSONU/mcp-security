# Copy to .env (git-ignored) for local runs, or inject via your secret manager.
# Required in every environment:
OIDC_ISSUER=https://idp.example.com/realms/your-realm
APP_PUBLIC_URL=https://mcp.example.com
POSTGRES_HOST=db.example.com
DATABASE_PASSWORD=
FLYWAY_USER=
FLYWAY_PASSWORD=

# Optional (defaults shown):
# POSTGRES_PORT=5432
# POSTGRES_DB=patient_db
# POSTGRES_SSLMODE=verify-full
# DATABASE_USERNAME=healthcare_app
# JWT_AUDIENCE=healthcare-mcp-server
# DB_POOL_SIZE=10
# FLYWAY_ENABLED=true

# For the hands-on guide (docs/cloud-iam-guide.md), used by scripts/device-login.js:
# OIDC_CLIENT_ID=healthcare-live-test
# SCOPES=openid patient.read medication.read notes.read
